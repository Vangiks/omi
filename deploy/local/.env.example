# Settings for deploy/local. init.sh copies this file to .env and fills in
# the secrets; keys can be added later by editing .env. Never commit .env.

# --- Secrets, generated by init.sh -------------------------------------------
# Encrypts user data in Firestore. Losing it makes that data unreadable, so
# back up .env together with the volumes.
ENCRYPTION_SECRET=
ADMIN_KEY=
# Shared between the backend and llm-gateway.
OMI_LLM_GATEWAY_SERVICE_TOKEN=
TYPESENSE_API_KEY=
SCREEN_FRAME_SIGNING_SECRET=

# --- Model providers ---------------------------------------------------------
# Direct keys; the backend calls these providers itself.
# Required: chat, conversation processing and memories run on OpenAI models.
OPENAI_API_KEY=
# Required: embeddings for screen-activity search and the desktop app.
GEMINI_API_KEY=
# Optional: chat routes Claude model names to OpenAI in gateway mode, so the
# key is used only if that routing is turned off.
ANTHROPIC_API_KEY=
# Optional: web search in chat; without it the chat answers without searching.
PERPLEXITY_API_KEY=

# --- Speech ------------------------------------------------------------------
# Deepgram transcribes recordings (STT_SERVICE_MODELS=dg-nova-3 in docker-compose.yaml).
DEEPGRAM_API_KEY=

# --- Optional ----------------------------------------------------------------
# Seconds between Firestore emulator snapshots; 0 turns them off.
# FIREBASE_SNAPSHOT_INTERVAL=300
