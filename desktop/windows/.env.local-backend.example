# Local-backend profile: the app talks to the Docker stack in deploy/local
# (see deploy/local/README.md at the repo root) instead of Omi's cloud.
# Copy to .env.local-backend and run `pnpm dev --mode local-backend`.
# Vite loads .env first, then this file on top, so every key below wins.

# Firebase emulator project from deploy/local/docker-compose.yaml. The emulator
# accepts any API key; the demo- prefix keeps the SDK off real Google projects.
VITE_FIREBASE_API_KEY=demo-omi-local-key
VITE_FIREBASE_AUTH_DOMAIN=demo-omi-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-omi-local
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Backends from the compose stack. Plain-http bases get added to the renderer
# CSP and the main-process CORS shim (src/main/localBackendOrigins.ts).
VITE_OMI_API_BASE=http://127.0.0.1:8000
VITE_OMI_DESKTOP_API_BASE=http://127.0.0.1:10201

# Cloud sync through the developer API is not used locally.
VITE_OMI_API_KEY=
